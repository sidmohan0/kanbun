{
  "name": "@kanbun/model",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workspace": "./src/workspace.ts",
    "./accounts": "./src/accounts.ts",
    "./registry": "./src/registry.ts",
    "./package.json": "./package.json",
    "./migrations/*": "./migrations/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "echo 'source package'",
    "db:generate": "drizzle-kit generate --config drizzle.workspace.config.ts && drizzle-kit generate --config drizzle.accounts.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
