{
  "name": "@kanbun/verifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "kanbun-verify": "./src/cli.mjs"
  },
  "scripts": {
    "verify": "node src/cli.mjs",
    "test": "node --test test/*.test.mjs",
    "test:recovery": "playwright test --config test/recovery/playwright.config.ts",
    "typecheck": "node --check src/cli.mjs && node --check src/index.mjs && node --check src/docs.mjs && tsc --noEmit -p test/recovery/tsconfig.json",
    "build": "echo 'source package'"
  },
  "devDependencies": {
    "@kanbun/model": "workspace:*",
    "@kanbun/mutators": "workspace:*",
    "@kanbun/sync": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
