{
  "name": "kanbun",
  "description": "A local-first issue tracker with collaborative editing and GitHub context.",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "build:verified": "pnpm --filter @kanbun/web build:verified && pnpm -r --filter '!@kanbun/web' build",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "install:cloudflare": "node scripts/install-cloudflare.mjs",
    "deploy": "node scripts/install-cloudflare.mjs deploy",
    "build:cloudflare": "pnpm --filter @kanbun/web build",
    "audit:public": "node scripts/public-audit.mjs",
    "test": "pnpm -r --no-sort --workspace-concurrency=${KANBUN_TEST_WORKSPACE_CONCURRENCY:-2} test",
    "test:changelog": "node --test scripts/check-changelog.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:verifier": "pnpm --filter @kanbun/verifier test",
    "test:recovery": "pnpm --filter @kanbun/verifier test:recovery",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @kanbun/seed run seed",
    "db:generate": "pnpm --filter @kanbun/model run db:generate",
    "spec:check": "node scripts/check-spec-lock.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "verify": "bash .devcontainer/verify-entry.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
