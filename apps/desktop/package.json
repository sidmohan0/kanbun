{
  "name": "@kanbun/desktop",
  "description": "Kanbun desktop issue tracker for people and agents.",
  "author": "Kanbun contributors",
  "homepage": "https://kanbun.ai",
  "desktopName": "ai.kanbun.desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.json --mac --publish never",
    "dist:windows": "pnpm build && electron-builder --config electron-builder.json --win --publish never",
    "dist:linux": "pnpm build && electron-builder --config electron-builder.json --linux --publish never",
    "test": "pnpm build && node --test test/policy.test.mjs test/collector.test.mjs && xvfb-run -a node --test test/shell.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316"
  }
}
