{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanbun-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "LOCAL_DEV": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceDO"
      },
      {
        "name": "DOCUMENTS",
        "class_name": "DocumentDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DocumentDO"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ]
}
