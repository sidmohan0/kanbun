{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanbun-preview",
  "account_id": "5af65814b462b37cf1e5bba7d499c3a5",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "kanbun.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "LOCAL_DEV": "false",
    "AUTH_MODE": "email",
    "APP_ORIGIN": "https://kanbun.ai",
    "AUTH_EMAIL_DOMAIN": "datafog.ai",
    "AUTH_FROM_EMAIL": "Kanbun <signin@auth.kanbun.ai>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFtZ_SkJCIGpthkt",
    "PREVIEW_OWNER_EMAIL": "sid@datafog.ai",
    "PREVIEW_WORKSPACE_ID": "01a18d7f-80a7-7e86-bd3c-3f6780cab4bb",
    "PREVIEW_WORKSPACE_NAME": "kanbun"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "kanbun-preview-accounts",
      "database_id": "08693f37-e1d1-4184-b315-babe37197e1f",
      "migrations_dir": "../../packages/model/migrations/accounts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACES",
        "class_name": "WorkspaceDO"
      },
      {
        "name": "DOCUMENTS",
        "class_name": "DocumentDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DocumentDO"]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "kanbun-preview-backups"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
