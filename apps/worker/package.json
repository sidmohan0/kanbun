{
  "name": "@kanbun/worker",
  "description": "Local Cloudflare Worker and SQLite workspace Durable Object for kanbun.",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./test/runtime.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787 --var LOCAL_DEV:true",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@kanbun/model": "workspace:*",
    "@kanbun/mutators": "workspace:*",
    "@kanbun/sync": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6",
    "wrangler": "4.156.0"
  }
}
