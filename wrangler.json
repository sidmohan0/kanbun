{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanbun",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "LOCAL_DEV": "false",
    "AUTH_MODE": "email",
    "INSTALLATION_STAGE": "setup",
    "APP_ORIGIN": "",
    "AUTH_EMAIL_DOMAIN": "",
    "AUTH_FROM_EMAIL": "",
    "TURNSTILE_SITE_KEY": "",
    "PREVIEW_OWNER_EMAIL": "",
    "PREVIEW_WORKSPACE_ID": "",
    "PREVIEW_WORKSPACE_NAME": ""
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "kanbun-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "packages/model/migrations/accounts"
    }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "kanbun-backups" }],
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACES", "class_name": "WorkspaceDO" },
      { "name": "DOCUMENTS", "class_name": "DocumentDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DocumentDO"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" }
}
