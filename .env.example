# App
NEXT_PUBLIC_APP_NAME=Kanbun
KANBUN_PORT=7890
KANBUN_URL=http://localhost:7890
OWNER_MODE_ENABLED=true
OWNER_EMAIL=replace-with-owner-email@example.com
OWNER_PASSWORD=replace-with-owner-password
IMPORT_WORKER_POLL_INTERVAL_MS=2000
IMPORT_WORKER_STALE_ROW_MS=300000
APP_ENCRYPTION_KEY=replace-with-32-plus-char-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Postgres
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=replace-with-postgres-db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DB_NAME
